  status          String   @default("draft") // draft, published, archived
  featured        Boolean  @default(false)
  featuredImage   String?  // Featured image URL
  
  // SEO
  metaKeywords_en String?
  metaKeywords_th String?
  ogImage         String?  // Open Graph image URL
  
  // Organization
  category        String   @default("general")  // general, policy, guides, info, etc.
  displayOrder    Int      @default(0)
  
  // Timestamps
  publishedAt     DateTime?
  createdBy       String?  // User ID who created
  updatedBy       String?  // User ID who last updated
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([slug])
  @@index([status])
  @@index([contentType])
  @@index([category])
  @@index([featured])
}
// Theme Configuration Model - Stores design system and UI theme settings
model ThemeConfig {
  id            String   @id @default(cuid())
  name          String   @unique  // e.g., "default", "dark", "light"
  isActive      Boolean  @default(false)  // Only one active theme at a time
  
  // Branding & Identity
  websiteName   String?  // e.g., "Samui Transfers"
  logoUrl       String?  // URL to logo image (deprecated: use headerLogoUrl)
  headerLogoUrl String?  // Header logo image URL
  footerLogoUrl String?  // Footer logo image URL
  faviconUrl    String?  // URL to favicon
  footerText    String?  // Custom footer text
  companyEmail  String?  // Company contact email
  companyPhone  String?  // Company contact phone
  
  // Developer/Company Credits
  developerCompanyName     String?  // e.g., "Sinthorndev Technologies"
  developerCompanyWebsite  String?  // Developer website URL
  developerCompanyEmail    String?  // Developer contact email
  
  // Color System
  colors        Json     // { primary, secondary, accent, success, danger, warning, neutral, custom }
  
  // Typography
  typography    Json     // { fontFamily, fontSizes, fontWeights, lineHeights }
  
  // Spacing & Layout
  spacing       Json     // { baseUnit, scales }
  borderRadius  Json     // { sm, md, lg, xl, full }
