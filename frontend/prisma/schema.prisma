// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?          @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String            @default("USER")
  disabled      Boolean           @default(false)
  preferredLanguage String        @default("en")
  marketingEmails   Boolean       @default(false)
  accounts      Account[]
  sessions      Session[]
  bookings      Booking[]
  auditActorLogs  AuditLog[]    @relation("AuditActor")
  auditTargetLogs AuditLog[]    @relation("AuditTarget")
  activityLogs  ActivityLog[] @relation("ActivityLogActor")
  driver        Driver?       @relation("DriverUser")
  smsMessages   SMSMessage[]  @relation("UserSMSMessages")
  smsSettings   SMSSettings?  @relation("UserSMSSettings")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([disabled])
  @@index([createdAt])
}
 
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Booking {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestNumber String?
  details    Json
  status     BookingStatus @default(PENDING)
  
  // Confirmation & Reference
  referenceNumber String?                  // Unique booking reference (e.g., BK-2025-001234)
  confirmationSentAt DateTime?             // When confirmation email was sent
  
  // Payment fields
  paymentStatus  String @default("PENDING")  // PENDING, COMPLETED, FAILED, REFUNDED
  paymentId      String?                     // Stripe Payment Intent ID
  paymentAmount  Decimal?                    // Amount paid in currency units
  paymentMethod  String?                     // Payment method type
  paymentDate    DateTime?                   // When payment was processed
  paymentProofStatus String?                 // UPLOADED, VERIFIED, REJECTED
  
  // Cancellation fields
  cancellationReason String?                // Reason for cancellation
  cancellationDate   DateTime?              // When booking was cancelled
  cancellationRequestedAt DateTime?         // When cancellation was requested
  refundAmount       Decimal?               // Amount refunded
  refundProcessedAt  DateTime?              // When refund was processed
  
  // Payment relationships
  payments       Payment[]
  paymentProofs  PaymentProof[]
  paymentReminders PaymentReminder[] @relation("BookingReminders")
  smsMessages    SMSMessage[]   @relation("BookingSMSMessages")

  // MULTI-SERVICE SUPPORT (New)
  serviceType       ServiceType @default(TRANSFER)  // TRANSFER, BOAT, TOUR, EVENT, PACKAGE
  serviceId         String?     // ID of service-specific booking (speedboatBookingId, tourBookingId, etc.)
  
  // Service-Specific Relations
  speedboatBooking  SpeedboatBooking?
  tourBooking       TourBooking?
  eventBooking      EventBooking?
  
  // Bundle Support
  isBundle          Boolean @default(false)  // true if combining services
  parentBookingId   String?     // For bundled bookings, reference parent
  parentBooking     Booking?  @relation("BundledBookings", fields: [parentBookingId], references: [id])
  childBookings     Booking[] @relation("BundledBookings")

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentId])
  @@index([referenceNumber])
  @@index([userId, createdAt])
  @@index([cancellationDate])
  @@index([serviceType])
  @@index([parentBookingId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model ActivityLog {
  id            String         @id @default(cuid())
  
  // Actor Information
  actorId       String
  actor         User           @relation("ActivityLogActor", fields: [actorId], references: [id], onDelete: Cascade)
  
  // Action Details
  action        String         // "CREATE", "UPDATE", "DELETE", "VIEW", "LOGIN", "LOGOUT", "ROLE_CHANGE", "BOOKING_CONFIRMED", etc.
  resourceType  String         // "USER", "BOOKING", "PAYMENT", "DRIVER", "SETTINGS", etc.
  resourceId    String?        // ID of affected resource
  
  // Change Details
  oldValues     Json?          // Previous values (for UPDATE)
  newValues     Json?          // New values (for UPDATE)
  details       String?        // Additional context
  
  // Request Information
  ipAddress     String?
  userAgent     String?
  
  // Timestamps
  createdAt     DateTime       @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

// Legacy AuditLog - kept for backwards compatibility
model AuditLog {
  id            String       @id @default(cuid())
  actorId       String
  actor         User         @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  targetUserId  String
  targetUser    User         @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  action        AuditAction
  details       Json
  createdAt     DateTime     @default(now())

  @@index([targetUserId, createdAt])
  @@index([actorId, createdAt])
  @@index([action])
}

enum AuditAction {
  USER_ROLE_CHANGED
  USER_DISABLED_TOGGLED
}

// Driver System (Feature #7)
model Driver {
  id                    String      @id @default(cuid())
  
  // User Reference
  userId                String      @unique
  user                  User        @relation("DriverUser", fields: [userId], references: [id], onDelete: Cascade)
  
  // Driver Information
  licenseNumber         String      @unique  // Driver license number
  licenseExpiry         DateTime?             // License expiration date
  licenseVerified       Boolean     @default(false)
  licenseVerifiedAt     DateTime?
  
  // Vehicle Assignment
  vehicleId             String?
  vehicleType           String?     // "minibus", "suv", "sedan" - for tracking
  registrationNumber    String?     // Vehicle registration
  
  // Status
  status                String      @default("offline")  // "available", "busy", "offline", "on_break"
  acceptingRides        Boolean     @default(true)
  
  // Location
  currentLatitude       Decimal?    @db.Decimal(10, 8)
  currentLongitude      Decimal?    @db.Decimal(11, 8)
  locationUpdatedAt     DateTime?
  
  // Performance
  totalTrips            Int         @default(0)
  cancelledTrips        Int         @default(0)
  completedTrips        Int         @default(0)
  averageRating         Decimal?    @db.Decimal(3, 2)  // 0-5 rating
  totalReviews          Int         @default(0)
  
  // Assignments
  assignments           DriverAssignment[]
  ratings               DriverRating[]
  
  // BOAT & TOUR CAPABILITIES (New)
  isBoatOperator        Boolean @default(false)
  isTourGuide           Boolean @default(false)
  certifications        Json?   // {"boatLicense": "...", "safetyTraining": "..."}
  
  // Relations for boat & tour services
  speedboatAssignments  SpeedboatCaptainAssignment[] @relation("SpeedboatCaptainAssignments")
  tourScheduleGuides    TourSchedule[]
  tourBookingGuides     TourBooking[] @relation("TourBookingGuides")
  speedboatBookingCaptains SpeedboatBooking[] @relation("SpeedboatBookingCaptain")
  
  // Compliance
  backgroundCheckStatus String?              // "PENDING", "APPROVED", "REJECTED"
  backgroundCheckDate   DateTime?
  insuranceExpiry       DateTime?
  
  // Timestamps
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([acceptingRides])
  @@index([locationUpdatedAt])
}

model DriverAssignment {
  id                String      @id @default(cuid())
  
  // Driver and Booking
  driverId          String
  driver            Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  bookingId         String
  
  // Assignment Details
  assignmentStatus  String      @default("assigned")  // "assigned", "accepted", "ongoing", "completed", "cancelled"
  assignedAt        DateTime    @default(now())
  acceptedAt        DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  
  // Location at assignment
  pickupLatitude    Decimal?    @db.Decimal(10, 8)
  pickupLongitude   Decimal?    @db.Decimal(11, 8)
  
  // Performance
  estimatedArrival  DateTime?
  actualArrival     DateTime?
  rating            Int?        // 1-5
  ratingComment     String?
  
  // Cancellation
  cancellationReason String?
  cancelledAt       DateTime?
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  @@index([driverId])
  @@index([bookingId])
  @@index([assignmentStatus])
  @@unique([bookingId])  // One driver per booking
}

model DriverRating {
  id                String      @id @default(cuid())
  
  // Driver and Rater
  driverId          String
  driver            Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  ratedBy           String      // User ID who gave the rating
  
  // Rating Details
  rating            Int         // 1-5 stars
  comment           String?
  categories        Json?       // {cleanliness, professionalism, safety, communication, punctuality}
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  @@index([driverId])
  @@index([rating])
}

model ServiceRate {
  id               String   @id @default(cuid())
  
  // ENHANCED FOR MULTI-SERVICE (New field)
  serviceType      ServiceType @default(TRANSFER)  // TRANSFER, BOAT, TOUR, EVENT
  
  vehicleType      String   // "minibus", "suv", "sedan" for TRANSFER, "speedboat_6person" for BOAT, etc.
  basePrice        Decimal  // Base price in THB
  distanceRate     Decimal  // Price per km
  minDistance      Int      // Minimum distance to apply rate
  maxDistance      Int?     // Maximum distance (null = unlimited)
  isActive         Boolean  @default(true)
  description      String?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  @@index([vehicleType])
  @@index([isActive])
  @@index([serviceType])
}

model PricingRule {
  id               String   @id @default(cuid())
  ruleType         String   // "PEAK_HOUR", "SEASONAL", "DISCOUNT"
  name             String
  multiplier       Decimal  // e.g., 1.5 for 50% increase
  startTime        DateTime // For recurring rules: time of day
  endTime          DateTime // For recurring rules: time of day
  startDate        DateTime? // For date-based rules
  endDate          DateTime? // For date-based rules
  dayOfWeek        Int[]     // [0-6] for Mon-Sun, empty = all days
  isActive         Boolean  @default(true)
  description      String?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  @@index([ruleType])
  @@index([isActive])
}

model RateHistory {
  id               String   @id @default(cuid())
  bookingId        String
  vehicleType      String
  basePrice        Decimal
  distanceRate     Decimal
  appliedRules     Json     // Array of applied pricing rules
  finalPrice       Decimal
  
  createdAt        DateTime @default(now())
  
  @@index([bookingId])
  @@index([createdAt])
}

model ChatbotContext {
  id        String   @id @default(cuid())
  key       String   // e.g., "ai-agent-default" or per-agent key
  locale    String   @default("en")
  content   String   // long context text (system context)
  title     String?
  enabled   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, locale])
  @@index([key])
  @@index([locale])
  @@index([enabled])
}

// Payment System Models (Phase 3)
model Payment {
  id                    String          @id @default(cuid())
  bookingId             String
  booking               Booking?        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  
  // Payment Details
  method                PaymentMethod   // "stripe" or "paypal"
  amount                Decimal
  currency              String          @default("THB")
  status                PaymentStatus   @default(PENDING)
  
  // Provider References
  stripeSessionId       String?         @unique  // Stripe Checkout Session ID
  stripePaymentIntentId String?         @unique  // Stripe Payment Intent ID
  paypalOrderId         String?         @unique  // PayPal Order ID
  
  // Payer Information
  payer                 String?         // Email or name of payer
  payerEmail            String?
  payerName             String?
  
  // Transaction Details
  transactionId         String?         @unique  // Reference transaction ID
  failureReason         String?         // Reason if payment failed
  failureCode           String?         // Error code from provider
  
  // Metadata
  metadata              Json?           // Additional data (booking details, etc.)
  webhookData           Json?           // Full webhook response
  
  // Webhooks
  webhooks              PaymentWebhook[]
  
  // Timestamps
  processedAt           DateTime?       // When payment was processed
  completedAt           DateTime?       // When payment was completed
  refundedAt            DateTime?       // When payment was refunded
  
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  
  // Indexes for queries
  @@index([bookingId])
  @@index([method])
  @@index([status])
  @@index([createdAt])
  @@index([processedAt])
  @@index([paypalOrderId])
  @@index([stripeSessionId])
  @@index([payerEmail])
}

enum PaymentMethod {
  stripe
  paypal
  bank_transfer
  cash
}

enum ServiceType {
  TRANSFER
  BOAT
  TOUR
  EVENT
  PACKAGE
}

model ServiceSetting {
  id                 String      @id @default(cuid())
  serviceType        ServiceType @unique
  isActive           Boolean     @default(true)
  maxCapacity        Int         @default(50)
  minBookingDays     Int         @default(1)
  maxBookingDays     Int         @default(365)
  commissionRate     Float       @default(15)
  description        String      @default("")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([serviceType])
  @@map("service_settings")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model PaymentWebhook {
  id            String    @id @default(cuid())
  paymentId     String
  payment       Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  
  // Webhook Details
  provider      String    // "stripe" or "paypal"
  eventType     String    // Event type (e.g., "payment_intent.succeeded")
  externalId    String    @unique  // Provider's webhook ID
  
  // Raw Data
  rawData       Json      // Full webhook payload
  
  // Processing Status
  processed     Boolean   @default(false)
  processedAt   DateTime?
  errorMessage  String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([paymentId])
  @@index([provider])
  @@index([eventType])
  @@index([processed])
  @@index([createdAt])
}

// Payment Proof Model (for bank transfer and manual payment verification)
model PaymentProof {
  id                  String   @id @default(cuid())
  bookingId           String
  booking             Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  
  // File Information
  fileName            String   // Stored filename (hash-based)
  originalFileName    String   // User's original filename
  filePath            String   // Path to file in storage
  fileSize            Int      // File size in bytes
  mimeType            String   // File MIME type
  
  // Upload Information
  uploadedAt          DateTime @default(now())
  uploadedBy          String   // Email of uploader
  
  // Payment Amount
  expectedAmount      Decimal  // Expected payment amount
  
  // Verification
  status              String @default("PENDING")  // PENDING, VERIFIED, REJECTED
  verifiedAt          DateTime?
  rejectedAt          DateTime?
  rejectionReason     String?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@index([bookingId])
  @@index([status])
  @@index([uploadedAt])
  @@index([uploadedBy])
}

// Payment Reminders System (Feature #3)
model PaymentReminder {
  id                String      @id @default(cuid())
  bookingId         String
  booking           Booking     @relation("BookingReminders", fields: [bookingId], references: [id], onDelete: Cascade)
  
  // Reminder Details
  reminderType      String      // FIRST_REMINDER, SECOND_REMINDER, FINAL_WARNING, BOOKING_CANCELLED
  status            String      @default("PENDING")  // PENDING, SENT, FAILED, CANCELLED
  
  // Sending Info
  sentAt            DateTime?
  failureReason     String?
  
  // Retry Logic
  nextRetryAt       DateTime?
  retryCount        Int         @default(0)
  maxRetries        Int         @default(3)
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  @@index([bookingId])
  @@index([status])
  @@index([reminderType])
  @@index([createdAt])
  @@index([nextRetryAt])
}

model PaymentReminderSettings {
  id                String      @id @default(cuid())
  reminderType      String      @unique  // FIRST_REMINDER, SECOND_REMINDER, FINAL_WARNING
  hoursAfterBooking Int                   // Hours after booking to send reminder
  enabled           Boolean     @default(true)
  emailTemplate     String                // Template name for email
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  @@index([reminderType])
  @@index([enabled])
}

// SMS Notifications System (Feature #4)
model SMSMessage {
  id                String      @id @default(cuid())
  bookingId         String?
  booking           Booking?    @relation("BookingSMSMessages", fields: [bookingId], references: [id], onDelete: Cascade)
  userId            String
  user              User        @relation("UserSMSMessages", fields: [userId], references: [id], onDelete: Cascade)
  
  // SMS Details
  phoneNumber       String      // Customer phone number
  messageType       String      // BOOKING_CONFIRMATION, PAYMENT_REMINDER, PAYMENT_CONFIRMATION, REFUND_NOTIFICATION, DRIVER_ASSIGNED, DRIVER_ARRIVING
  content           String      // SMS message content
  
  // Status
  status            String      @default("PENDING")  // PENDING, SENT, FAILED, BOUNCED, OPTED_OUT
  sentAt            DateTime?
  deliveredAt       DateTime?
  failureReason     String?
  
  // Twilio Details
  twiliSid          String?     @unique  // Twilio message SID
  twiliStatus       String?     // Twilio delivery status
  twiliErrorCode    Int?        // Twilio error code if failed
  
  // Retry Logic
  nextRetryAt       DateTime?
  retryCount        Int         @default(0)
  maxRetries        Int         @default(3)
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  @@index([bookingId])
  @@index([userId])
  @@index([status])
  @@index([messageType])
  @@index([sentAt])
  @@index([createdAt])
}

model SMSTemplate {
  id                String      @id @default(cuid())
  messageType       String      @unique  // BOOKING_CONFIRMATION, PAYMENT_REMINDER, etc.
  template          String      // SMS template with {placeholders}
  enabled           Boolean     @default(true)
  maxLength         Int         @default(160)  // SMS character limit
  description       String?
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  @@index([messageType])
  @@index([enabled])
}

model SMSSettings {
  id                String      @id @default(cuid())
  userId            String      @unique
  user              User        @relation("UserSMSSettings", fields: [userId], references: [id], onDelete: Cascade)
  
  // Preferences
  phoneNumber       String?     // Verified phone number
  phoneVerified     Boolean     @default(false)
  phoneVerifiedAt   DateTime?
  
  // Opt-out Settings
  optedOut          Boolean     @default(false)
  optedOutAt        DateTime?
  optedOutReason    String?
  
  // Notification Preferences
  bookingConfirmation     Boolean @default(true)
  paymentReminders        Boolean @default(true)
  paymentConfirmation     Boolean @default(true)
  refundNotification      Boolean @default(true)
  driverNotifications     Boolean @default(true)
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  @@index([userId])
}

// Payment Gateway Management (Admin controlled)
model PaymentGateway {
  id                String    @id @default(cuid())
  type              String    @unique  // "stripe", "paypal", "bank_transfer"
  displayName       String              // Display name (e.g., "Credit Card", "PayPal", "Bank Transfer")
  description       String?             // Short description for admin
  
  // Visibility & Status
  isPublic          Boolean   @default(true)  // Whether to show to users
  enabled           Boolean   @default(true)  // Admin toggle
  displayOrder      Int       @default(0)     // Order in which to display
  
  // Configuration
  icon              String?             // Icon emoji or URL
  processingTime    String?             // "Instant", "1-3 days", etc.
  fees              String?             // Fee information
  metadata          Json?               // Additional config data
  
  // Credentials (encrypted in database)
  credentials       PaymentGatewayCredential?  // One-to-one relationship with credentials
  
  // Tracking
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([type])
  @@index([isPublic])
  @@index([enabled])
  @@index([displayOrder])
}

// Payment Gateway Credentials (stored separately and encrypted)
model PaymentGatewayCredential {
  id                String    @id @default(cuid())
  
  // Gateway Reference
  gatewayId         String    @unique
  gateway           PaymentGateway  @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  
  // Stripe Credentials (encrypted)
  stripePublicKey   String?           // Stripe publishable key (safe to expose to frontend)
  stripeSecretKey   String?           // Stripe secret key (encrypted, admin only)
  stripeAccountId   String?           // Stripe account ID (encrypted)
  
  // PayPal Credentials (encrypted)
  paypalClientId    String?           // PayPal client ID (encrypted)
  paypalSecret      String?           // PayPal client secret (encrypted)
  paypalAccountId   String?           // PayPal account ID (encrypted)
  paypalMode        String?           // "SANDBOX" or "LIVE"
  
  // Bank Transfer Credentials (encrypted)
  bankAccountName   String?           // Account holder name (encrypted)
  bankAccountNumber String?           // Account number (encrypted)
  bankBankName      String?           // Bank name
  
  // Thailand-specific (encrypted)
  bankSwiftCode     String?           // SWIFT code (e.g., BKKATH22 for Krungsri)
  bankBankBranch    String?           // Bank branch name (encrypted)
  
  // International transfers (encrypted)
  bankIban          String?           // IBAN for EU/international (encrypted)
  bankRoutingNumber String?           // US Routing number or alternative (encrypted)
  
  // Status
  isConfigured      Boolean   @default(false)  // Whether credentials are complete
  lastVerified      DateTime?                   // Last time credentials were tested
  verificationStatus String?                    // "PENDING", "VALID", "INVALID"
  
  // Tracking
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([gatewayId])
  @@index([isConfigured])
}

// Audit log for sensitive credential changes
model PaymentGatewayAuditLog {
  id                String    @id @default(cuid())
  gatewayId         String
  
  // Action info
  action            String             // "CREATE", "UPDATE", "VIEW", "DELETE"
  changedFields     String[]           // Fields that were changed (without values)
  adminId           String?            // Admin who made the change
  
  // Request info
  ipAddress         String?
  userAgent         String?
  
  createdAt         DateTime  @default(now())
  
  @@index([gatewayId, createdAt])
  @@index([adminId, createdAt])
  @@index([action])
}

// ═══════════════════════════════════════════════════════════════
// SPEEDBOAT SERVICE MODELS (New)
// ═══════════════════════════════════════════════════════════════

model Speedboat {
  id                String    @id @default(cuid())
  name              String    // "Speed Boat A", "Express II", etc.
  boatType          String    // "6-person", "12-person", "luxury", etc.
  
  // Specifications
  capacity          Int       // Maximum passengers
  crewSize          Int       // Captain + crew required
  length            Decimal?  // Length in meters
  color             String?   // Boat color/identifier
  registrationNumber String? @unique  // Boat registration ID
  
  // Location & Operations
  homePort          String    // Base location (e.g., "Koh Samui Marina")
  currentLocation   String?   // Current location
  
  // Status & Availability
  status            String @default("AVAILABLE")  // AVAILABLE, MAINTENANCE, RETIRED, OUT_OF_SERVICE
  maintenanceUntil  DateTime?
  
  // Operational Details
  manufacturerYear  Int?
  lastMaintenanceDate DateTime?
  nextMaintenanceDate DateTime?
  maintenanceNotes  String?
  
  // Safety & Compliance
  safetyInspectionDate DateTime?
  safetyInspectionValid Boolean @default(true)
  safetyEquipmentList Json?
  insuranceExpiry   DateTime?
  
  // Fuel & Consumption
  fuelType          String    // "Petrol", "Diesel", "Electric"
  fuelCapacity      Decimal   // Liters
  fuelConsumption   Decimal?  // Liters per km (estimated)
  
  // Pricing Reference
  speedboatRates    SpeedboatRate[]
  
  // Bookings
  speedboatBookings SpeedboatBooking[]
  
  // Captain/Crew Assignments
  captainAssignments SpeedboatCaptainAssignment[]
  
  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([status])
  @@index([homePort])
  @@index([boatType])
  @@index([maintenanceUntil])
}

model SpeedboatRate {
  id                String    @id @default(cuid())
  speedboatId       String
  speedboat         Speedboat @relation(fields: [speedboatId], references: [id], onDelete: Cascade)
  
  // Service Details
  serviceType       String    // "DAY_TRIP", "ISLAND_HOPPING", "SPECIAL_EVENT"
  duration          Int       // Minutes (e.g., 480 for 8-hour trip)
  
  // Pricing
  basePrice         Decimal   // Base price for standard conditions
  pricePerPerson    Decimal?  // If applicable
  
  // Capacity Pricing
  minCapacity       Int       // Minimum number of people to book
  maxCapacity       Int       // Maximum (usually boat capacity)
  capacityDiscount  Decimal?  // Percentage discount for full capacity
  
  // Surcharges
  fuelSurcharge     Decimal?  // Additional fuel cost per km or per trip
  crewCost          Decimal?  // Captain + crew cost (may be included in base)
  
  // Peak Season
  isSeasonalRate    Boolean @default(false)
  seasonStart       Int?      // Month (1-12)
  seasonEnd         Int?
  seasonMultiplier  Decimal @default(1.0)
  
  // Active Period
  validFrom         DateTime  @default(now())
  validUntil        DateTime?
  
  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([speedboatId])
  @@index([serviceType])
  @@index([validFrom])
}

model Vehicle {
  id                    String      @id @default(cuid())
  
  // Identity & Type
  name                  String      // "Minibus A", "SUV-01", "Sedan Blue", etc.
  vehicleType           String      // "minibus", "suv", "sedan", "pickup", etc.
  registrationNumber    String?     @unique  // License plate
  
  // Specifications
  capacity              Int         // Maximum passenger capacity
  color                 String?     // Vehicle color
  yearOfManufacture     Int?        // Manufacturing year
  
  // Location & Operations
  homePort              String      // Base location (e.g., "Koh Samui Town", "Airport")
  currentLocation       String?     // Current location
  
  // Status & Availability
  status                String      @default("AVAILABLE")  // AVAILABLE, MAINTENANCE, RETIRED, OUT_OF_SERVICE
  isActive              Boolean     @default(true)
  maintenanceUntil      DateTime?   // Unavailable until this date
  
  // Maintenance & Safety
  lastMaintenanceDate   DateTime?
  nextMaintenanceDate   DateTime?
  maintenanceNotes      String?
  safetyInspectionDate  DateTime?
  safetyInspectionValid Boolean     @default(true)
  insuranceExpiry       DateTime?
  
  // Operational Details
  mileage               Int?        // Current odometer reading
  fuelType              String?     // "Petrol", "Diesel", "Electric", "Hybrid"
  fuelCapacity          Decimal?    // Tank size in liters
  fuelConsumption       Decimal?    // Avg consumption per km
  
  // Relations
  // vehicleBookings    VehicleTransferBooking[]  // Future: if we track vehicle-level bookings
  
  // Timestamps
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  
  @@index([vehicleType])
  @@index([status])
  @@index([homePort])
  @@index([isActive])
  @@index([registrationNumber])
}

model SpeedboatBooking {
  id                String    @id @default(cuid())
  bookingId         String    @unique
  booking           Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  
  speedboatId       String
  speedboat         Speedboat @relation(fields: [speedboatId], references: [id])
  
  // Trip Details
  tripType          String    // "DAY_TRIP", "ISLAND_HOPPING", "SUNSET_CRUISE", etc.
  departureTime     DateTime
  returnTime        DateTime
  departurePort     String
  returnPort        String
  estimatedDistance Decimal?  // KM
  
  // Passenger Details
  passengerCount    Int
  specialRequests   String?   // Dietary, accessibility, etc.
  
  // Crew Assignment
  captainId         String?
  captain           Driver?   @relation("SpeedboatBookingCaptain", fields: [captainId], references: [id])
  
  // Additional Services
  mealIncluded      Boolean @default(false)
  mealType          String?   // "LIGHT_SNACKS", "LUNCH", "DINNER", "FULL_BAR"
  equipmentRental   String?   // "SNORKEL_GEAR", "LIFE_JACKET", etc. (JSON array)
  
  // Status & Tracking
  status            String @default("PENDING")  // PENDING, CONFIRMED, IN_PROGRESS, COMPLETED, CANCELLED
  cancellationReason String?
  cancellationTime  DateTime?
  
  // Weather/Safety Notes
  weatherCancelled  Boolean @default(false)
  weatherNote       String?
